# ==========================================================================
# CalaPlayerSrcmBuilder - what stays OUT of the repository (and why)
#
# Rule of thumb: source, docs and small UI assets are tracked; everything that
# is (a) generated, (b) huge, or (c) somebody else's binary / game data is not.
# The ready-to-run builds live in GitHub Releases instead of in git.
#
# NOTE: git only treats a line as a comment when `#` is the FIRST character.
#       There are no trailing comments in this file on purpose.
# ==========================================================================

# ---- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# the project venv (~118 MB, machine specific)
python/

# ---- Node ---------------------------------------------------------------
# `npm.cmd install` rebuilds it
node_modules/

# vite output, `npm.cmd run build` rebuilds it
gui/dist/

# ---- build outputs / intermediates --------------------------------------
# PyInstaller work dir
build_out/

# dotnet publish output (~172 MB)
tools-src/**/bin/

# NuGet restore graph; regenerated by `dotnet restore`
tools-src/**/obj/

*.pdb

# ---- deliverables (uploaded as Release assets, never committed) ----------
# ~770 MB of ready-to-ship Kits
dist/

# ~57 MB self-contained tool chain; see README section 6
kit/

# ---- runtime scratch ----------------------------------------------------
# a build's working / output folder
out_patch/
build.log
build_report.json

# ---- tests: scratch material and the sandbox ----------------------------
# tests/fakegame is HARD-LINKED TO THE REAL GAME (858 MB .ucas = the game's own
# data) - it must never be published.
tests/mat/
tests/fakegame/

# ---- logs ---------------------------------------------------------------
# the self-test writes logs + screenshots here; the ones used by the README are
# copied into docs/images/ and tracked there
logs/

# ---- editor / OS --------------------------------------------------------
.vs/
*.user
Thumbs.db
desktop.ini
